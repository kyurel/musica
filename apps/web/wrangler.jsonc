// Cloudflare Workers deploy (OpenNext adapter, free plan).
// The app is only served on the custom domain, which Cloudflare Access protects;
// the public *.workers.dev address and preview URLs are switched off.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "musica",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": false,
  "preview_urls": false,
  // The second entry is a plain route on the same name: the zone's catch-all "not found" route
  // *.brakyuro.com/* would otherwise answer musica too (a route beats a custom domain), and the
  // more specific route wins. Access still runs first.
  "routes": [
    { "pattern": "musica.brakyuro.com", "custom_domain": true },
    { "pattern": "musica.brakyuro.com/*", "zone_name": "brakyuro.com" }
  ],
  "observability": { "enabled": true }
}
