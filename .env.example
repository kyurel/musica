# Public values (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Worker (on each Mac). The worker signs in as a normal user; its refresh token is
# stored in the macOS Keychain, not here.
MUSICA_SUPABASE_URL=https://<project-ref>.supabase.co
MUSICA_SUPABASE_ANON_KEY=
MUSICA_RUNNER_NAME=andre-mac
# comma-separated: analyse, preview, heavy
MUSICA_CAPABILITIES=analyse,preview,heavy
# Where lossless files live on this Mac (synced with Syncthing)
MUSICA_LIBRARY_ROOT=~/Music/Musica
# Where `musica-worker export` writes playlists (one stable folder for DJ software)
MUSICA_EXPORT_DIR="~/Music/Musica Exports"
# Where nightly backups go on this Mac (keep it outside the library folder)
MUSICA_BACKUP_DIR="~/Musica Backups"
# Web app only (server side): previews bucket on Cloudflare R2, token scoped to this bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREVIEWS_BUCKET=musica-previews
# Worker: where to ask for preview upload URLs
MUSICA_API_URL=https://musica.brayuro.com
# Worker: Cloudflare Access service token, so the worker can reach the web app (docs/DEPLOY.md)
MUSICA_ACCESS_CLIENT_ID=
MUSICA_ACCESS_CLIENT_SECRET=
